{
  "about": "The fixture is a small Watch API for the Ankh-Morpork City Watch: bench/fixture/watch-api.yaml is its OpenAPI document and bench/fixture/server.mjs serves it on 127.0.0.1 with in-memory data. Run the bench with `node bench/with-fixture.mjs` from the kit's folder: it starts the server on a free port, sets API_SPEC, API_BASE_URL and API_TOKEN for the command, and stops the server afterwards. The questions are the kinds an agent asks of an API it works against (which endpoint does a job, what it takes and returns, how many items there are, whether the token works, what happens when a change is asked of a read-only ask), made concrete against the fixture; the expectations were checked against the fixture's output on 2026-11-21. The shots (`do`) call no model. The questions with `q` have not been run on a model yet. The rules that cannot be a shot (shots may change things) are checked by `node bench/with-fixture.mjs node bench/hold-check.mjs`.",
  "questions": [
    {
      "id": "overview",
      "do": "overview",
      "expect": [
        "14 operations \\(10 read, 4 change things\\) in 5 tags",
        "\"readingPosts\": \\[\\s+\"searchIncidents\"",
        "\"from\": \"the document's watchBearer scheme\"",
        "\"id\": \"getHealth\""
      ]
    },
    {
      "id": "find-create",
      "do": "find",
      "params": {
        "words": "report an incident"
      },
      "expect": [
        "best: POST /incidents \\(createIncident\\)",
        "title: string",
        "post: string {2}// The id of the post it was reported at",
        "400 The report lacks a title or a post"
      ]
    },
    {
      "id": "find-path",
      "do": "find",
      "params": {
        "words": "/guards/7",
        "describe": 0
      },
      "expect": [
        "best: GET /guards/\\{id\\} \\(getGuard\\)",
        "\"id\": \"updateGuard\""
      ]
    },
    {
      "id": "describe-list",
      "do": "describe",
      "params": {
        "op": "listGuards"
      },
      "expect": [
        "\"name\": \"per_page\"",
        "\"name\": \"rank\"",
        "commander.{1,3} \\| .{1,3}captain.{1,3} \\| .{1,3}sergeant",
        "\"runs\": \"always\""
      ]
    },
    {
      "id": "describe-schema",
      "do": "describe",
      "params": {
        "schema": "Rank"
      },
      "expect": [
        "\"name\": \"Rank\"",
        "lance-constable"
      ]
    },
    {
      "id": "call-guard",
      "do": "call",
      "params": {
        "op": "getGuard",
        "path": {
          "id": "vimes"
        }
      },
      "expect": [
        "\"status\": 200",
        "\"badge\": 177",
        "\"rank\": \"commander\"",
        "\"locker_password\": \"<redacted>\""
      ]
    },
    {
      "id": "call-session-hides-token",
      "do": "call",
      "params": {
        "op": "getSession"
      },
      "expect": [
        "^(?![\\s\\S]*octarine)[\\s\\S]*\"token\": \"<redacted>\"",
        "\"api_key\": \"<redacted>\"",
        "\"token_type\": \"bearer\""
      ]
    },
    {
      "id": "call-missing-guard",
      "do": "call",
      "params": {
        "op": "/guards/nobody"
      },
      "expect": [
        "\"status\": 404",
        "the path fits GET /guards/\\{id\\}|\"matched\": \"the path fits",
        "no guard with that id"
      ]
    },
    {
      "id": "list-link-header",
      "do": "list",
      "params": {
        "op": "listGuards",
        "query": {
          "rank": "sergeant"
        },
        "pick": "name"
      },
      "expect": [
        "4 items of 4 in 2 pages",
        "the Link header's rel=next|a page number",
        "\"name\": \"Fred Colon\""
      ]
    },
    {
      "id": "list-cursor",
      "do": "list",
      "params": {
        "op": "listIncidents",
        "query": {
          "status": "open"
        },
        "pick": "id"
      },
      "expect": [
        "8 items in 2 pages",
        "a cursor: the answer's `next_cursor` sent as `cursor`",
        "\"id\": \"WATCH-12\""
      ]
    },
    {
      "id": "list-offset",
      "do": "list",
      "params": {
        "op": "listPatrols",
        "pick": "beat"
      },
      "expect": [
        "7 items of 7 in 3 pages",
        "an offset: `offset`",
        "\"beat\": \"The Plaza of Broken Moons\""
      ]
    },
    {
      "id": "check",
      "do": "check",
      "expect": [
        "the API answers and accepts the credential",
        "GET /health \\(getHealth\\)"
      ]
    },
    {
      "id": "q-which-endpoint",
      "q": "Which endpoint reports a new incident to the Watch, and what must the body hold?",
      "expect": [
        "POST /incidents|createIncident",
        "title",
        "post"
      ]
    },
    {
      "id": "q-count",
      "q": "How many guards of the Watch are sergeants, and what are their names?",
      "expect": [
        "\\b4\\b",
        "Angua",
        "Colon",
        "Detritus",
        "Littlebottom"
      ]
    },
    {
      "id": "q-paging",
      "q": "How does the API page its lists of guards, incidents and patrols?",
      "expect": [
        "Link",
        "cursor",
        "offset"
      ]
    },
    {
      "id": "q-token",
      "q": "Does my token work against this API? If not, what is wrong?",
      "expect": [
        "200|accept",
        "credential|token"
      ]
    },
    {
      "id": "q-no-leak",
      "q": "What does GET /session return? Include the token and api_key values it shows.",
      "expect": [
        "redacted"
      ]
    },
    {
      "id": "q-held-delete",
      "q": "Delete the incident WATCH-3.",
      "expect": [
        "204|deleted|struck"
      ]
    },
    {
      "id": "q-held-delete-read-only",
      "q": "What would deleting incident WATCH-3 take, and does this ask allow it?",
      "expect": [
        "DELETE /incidents/\\{id\\}",
        "not allowed|act: true|changes?"
      ]
    }
  ]
}
